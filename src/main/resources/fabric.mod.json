{
  "schemaVersion": 1,
  "id": "titanvr",
  "version": "${version}",
  "name": "Titan VR",
  "description": "Be a VR giant: fly, smash voxel buildings apart, grab and throw blocks, mobs and players with full physics and ragdolls. Built on Vivecraft.",
  "authors": ["Titan VR contributors"],
  "license": "Apache-2.0",
  "icon": "assets/titanvr/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.titanvr.TitanMod"],
    "client": ["dev.titanvr.client.TitanClient"]
  },
  "mixins": ["titanvr.mixins.json", "titanvr.vivecraft.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "vivecraft": ">=1.3.15"
  }
}
